{
  "name": "triagem-upa",
  "version": "1.0.0",
  "description": "Sistema de Triagem para UPA",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --experimental-specifier-resolution=node --loader ts-node/esm ./src/index.ts",
    "test": "node --experimental-specifier-resolution=node --loader ts-node/esm --test \"tests/*.test.ts\"",
    "test:watch": "node --test --watch tests/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "directories": {
    "test": "tests"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "arg": "^4.1.3",
    "create-require": "^1.1.1",
    "diff": "^4.0.4",
    "make-error": "^1.3.6",
    "undici-types": "^6.21.0",
    "v8-compile-cache-lib": "^3.0.1",
    "yn": "^3.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreAnimator/sistemaUPA.git"
  },
  "keywords": [],
