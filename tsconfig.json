{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,

    "strict": true,
    "noEmit": true,
    
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "ts-node": { "esm": true },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}